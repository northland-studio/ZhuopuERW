# ===== 服务 =====
NODE_ENV=development
HOST=127.0.0.1
PORT=3901
SITE_URL=http://localhost:5173

# 至少 32 位随机串；生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 第一个用它登录的账号自动成为管理员
ADMIN_EMAIL=

# ===== 数据库（SQLite，WAL）=====
# 默认 server/data/zhuopu.db
DB_FILE=

# ===== 邮件（noreply@xuanjian.top）=====
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@xuanjian.top
SMTP_PASS=
SMTP_FROM_NAME=琢璞英语讲评工作台

# 验证码策略
CODE_TTL_MINUTES=10
CODE_RESEND_SECONDS=60
CODE_MAX_PER_EMAIL_PER_HOUR=8
CODE_MAX_PER_IP_PER_HOUR=30

# ===== 七牛（公开空间 zhuopu，新加坡区）=====
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=zhuopu
QINIU_REGION=as0
QINIU_DOMAIN=https://cdn.zp.xuanjian.top

# ===== MinerU（docx/PDF 转文字）=====
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL=vlm

# ===== 大模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GLM_API_KEY=
GLM_MODEL=glm-4.6v-flash
